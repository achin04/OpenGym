# Copy this file to .env for local development.
# Never commit real secrets in .env.

# Used by Prisma to connect to the local PostgreSQL development database.
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@127.0.0.1:5432/opengym_dev?schema=public"

# Clerk authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="YOUR_CLERK_PUBLISHABLE_KEY"
CLERK_SECRET_KEY="YOUR_CLERK_SECRET_KEY"

# Comma-separated email addresses allowed to access admin operations.
ADMIN_EMAILS="admin@example.com"

# Google Maps Embed API key for venue maps on run detail pages.
# Restrict it by HTTP referrer and to the Maps Embed API only; it is visible in page HTML.
# Optional: without it, run pages fall back to a styled placeholder map.
GOOGLE_MAPS_EMBED_API_KEY="YOUR_GOOGLE_MAPS_EMBED_API_KEY"

# Shared secret for the Toronto import cron endpoint.
# Vercel Cron sends it as `Authorization: Bearer $CRON_SECRET`; set the same
# value in the Vercel project so the scheduler is accepted. Without it the
# endpoint refuses to run rather than running unauthenticated.
CRON_SECRET="YOUR_CRON_SECRET"
